-- Scripts:

local function SNKHFD_fake_script() -- CheatGUI.MainController 
	local script = Instance.new('LocalScript', CheatGUI)

	-- HRNR Cheat GUI Controller
	-- Fully client-side GUI + feature hooks for Studio testing / executor use
	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LocalPlayer = Players.LocalPlayer
	local Camera = workspace.CurrentCamera
	
	local gui = script.Parent
	local main = gui:WaitForChild("MainFrame")
	local content = main:WaitForChild("Content")
	local combatPage = content:WaitForChild("CombatPage")
	local visualsPage = content:WaitForChild("VisualsPage")
	local movementPage = content:WaitForChild("MovementPage")
	
	local tabBar = main:WaitForChild("TabBar")
	local combatTab = tabBar:WaitForChild("CombatTab")
	local visualsTab = tabBar:WaitForChild("VisualsTab")
	local movementTab = tabBar:WaitForChild("MovementTab")
	local closeBtn = main:WaitForChild("CloseBtn")
	
	-- State
	local state = {
		Aimbot = false,
		SilentAim = false,
		Triggerbot = false,
		ESP = false,
		BoxESP = false,
		NameESP = false,
		Tracers = false,
		Speed = false,
		Fly = false,
		Noclip = false,
		InfJump = false,
		AimFOV = 80,
		WalkSpeed = 16,
		DefaultSpeed = 16,
	}
	
	local connections = {}
	local drawings = {} -- for ESP objects
	
	-- Helpers
	local function setToggle(btn, on)
		if on then
			btn.Text = btn.Name:gsub("Toggle", "") .. ": ON"
			btn.BackgroundColor3 = Color3.fromRGB(40, 120, 80)
		else
			btn.Text = btn.Name:gsub("Toggle", "") .. ": OFF"
			btn.BackgroundColor3 = Color3.fromRGB(30, 30, 46)
		end
	end
	
	local function switchTab(page)
		combatPage.Visible = (page == combatPage)
		visualsPage.Visible = (page == visualsPage)
		movementPage.Visible = (page == movementPage)
	
		combatTab.BackgroundColor3 = (page == combatPage) and Color3.fromRGB(38, 38, 56) or Color3.fromRGB(26, 26, 38)
		visualsTab.BackgroundColor3 = (page == visualsPage) and Color3.fromRGB(38, 38, 56) or Color3.fromRGB(26, 26, 38)
		movementTab.BackgroundColor3 = (page == movementPage) and Color3.fromRGB(38, 38, 56) or Color3.fromRGB(26, 26, 38)
	end
	
	-- Tab switching
	combatTab.MouseButton1Click:Connect(function() switchTab(combatPage) end)
	visualsTab.MouseButton1Click:Connect(function() switchTab(visualsPage) end)
	movementTab.MouseButton1Click:Connect(function() switchTab(movementPage) end)
	
	closeBtn.MouseButton1Click:Connect(function()
		main.Visible = false
	end)
	
	-- Toggle GUI with RightShift
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.Insert then
			main.Visible = not main.Visible
		end
	end)
	
	-- Make frame draggable
	local dragging = false
	local dragStart, startPos
	main.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	main.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	
	-- ========== COMBAT ==========
	local aimbotBtn = combatPage:WaitForChild("AimbotToggle")
	local silentBtn = combatPage:WaitForChild("SilentAimToggle")
	local triggerBtn = combatPage:WaitForChild("TriggerbotToggle")
	local fovLabel = combatPage:WaitForChild("FOVLabel")
	local fovMinus = combatPage:WaitForChild("FOVMinus")
	local fovPlus = combatPage:WaitForChild("FOVPlus")
	
	aimbotBtn.MouseButton1Click:Connect(function()
		state.Aimbot = not state.Aimbot
		setToggle(aimbotBtn, state.Aimbot)
	end)
	
	silentBtn.MouseButton1Click:Connect(function()
		state.SilentAim = not state.SilentAim
		setToggle(silentBtn, state.SilentAim)
	end)
	
	triggerBtn.MouseButton1Click:Connect(function()
		state.Triggerbot = not state.Triggerbot
		setToggle(triggerBtn, state.Triggerbot)
	end)
	
	fovMinus.MouseButton1Click:Connect(function()
		state.AimFOV = math.max(10, state.AimFOV - 5)
		fovLabel.Text = "Aim FOV: " .. state.AimFOV
	end)
	
	fovPlus.MouseButton1Click:Connect(function()
		state.AimFOV = math.min(360, state.AimFOV + 5)
		fovLabel.Text = "Aim FOV: " .. state.AimFOV
	end)
	
	-- ========== VISUALS ==========
	local espBtn = visualsPage:WaitForChild("ESPToggle")
	local boxBtn = visualsPage:WaitForChild("BoxESPToggle")
	local nameBtn = visualsPage:WaitForChild("NameESPToggle")
	local tracersBtn = visualsPage:WaitForChild("TracersToggle")
	
	local function clearESP()
		for _, d in pairs(drawings) do
			if typeof(d) == "Instance" then
				d:Destroy()
			end
		end
		drawings = {}
	end
	
	local function createESPFor(player)
		if player == LocalPlayer then return end
		local char = player.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local head = char:FindFirstChild("Head")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not head or not hum then return end
	
		if state.NameESP then
			local bill = Instance.new("BillboardGui")
			bill.Name = "NameESP"
			bill.Adornee = head
			bill.Size = UDim2.new(0, 120, 0, 30)
			bill.StudsOffset = Vector3.new(0, 2.5, 0)
			bill.AlwaysOnTop = true
			bill.Parent = head
	
			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.Text = player.Name
			label.TextColor3 = Color3.fromRGB(80, 180, 255)
			label.TextStrokeTransparency = 0.4
			label.Font = Enum.Font.GothamBold
			label.TextSize = 14
			label.Parent = bill
	
			table.insert(drawings, bill)
		end
	
		if state.BoxESP then
			local highlight = Instance.new("Highlight")
			highlight.Name = "BoxESP"
			highlight.Adornee = char
			highlight.FillColor = Color3.fromRGB(80, 180, 255)
			highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
			highlight.FillTransparency = 0.7
			highlight.OutlineTransparency = 0
			highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			highlight.Parent = char
			table.insert(drawings, highlight)
		end
	end
	
	local function refreshESP()
		clearESP()
		if not (state.ESP or state.BoxESP or state.NameESP or state.Tracers) then return end
		for _, plr in ipairs(Players:GetPlayers()) do
			createESPFor(plr)
		end
	end
	
	espBtn.MouseButton1Click:Connect(function()
		state.ESP = not state.ESP
		setToggle(espBtn, state.ESP)
		if state.ESP then
			state.BoxESP = true
			state.NameESP = true
			setToggle(boxBtn, true)
			setToggle(nameBtn, true)
		else
			state.BoxESP = false
			state.NameESP = false
			state.Tracers = false
			setToggle(boxBtn, false)
			setToggle(nameBtn, false)
			setToggle(tracersBtn, false)
		end
		refreshESP()
	end)
	
	boxBtn.MouseButton1Click:Connect(function()
		state.BoxESP = not state.BoxESP
		setToggle(boxBtn, state.BoxESP)
		refreshESP()
	end)
	
	nameBtn.MouseButton1Click:Connect(function()
		state.NameESP = not state.NameESP
		setToggle(nameBtn, state.NameESP)
		refreshESP()
	end)
	
	tracersBtn.MouseButton1Click:Connect(function()
		state.Tracers = not state.Tracers
		setToggle(tracersBtn, state.Tracers)
		-- Tracers can be extended with Drawing library or Beam objects
	end)
	
	Players.PlayerAdded:Connect(function(plr)
		plr.CharacterAdded:Connect(function()
			task.wait(0.5)
			if state.ESP or state.BoxESP or state.NameESP then
				createESPFor(plr)
			end
		end)
	end)
	
	for _, plr in ipairs(Players:GetPlayers()) do
		plr.CharacterAdded:Connect(function()
			task.wait(0.5)
			if state.ESP or state.BoxESP or state.NameESP then
				createESPFor(plr)
			end
		end)
	end
	-- ========== CAMERA FOV CHANGER ==========
	local Camera = workspace.CurrentCamera
	
	-- state
	state.CamFOV = 70          -- default Roblox FOV
	state.DefaultCamFOV = 70
	
	-- grab the UI (adjust names if you put them elsewhere)
	local camFovLabel = combatPage:WaitForChild("CamFOVLabel")   -- or your label
	local camFovMinus = combatPage:WaitForChild("CamFOVMinus")
	local camFovPlus  = combatPage:WaitForChild("CamFOVPlus")
	
	-- apply function
	local function applyCamFOV()
		Camera.FieldOfView = state.CamFOV
	end
	
	-- buttons
	camFovMinus.MouseButton1Click:Connect(function()
		state.CamFOV = math.clamp(state.CamFOV - 5, 1, 120)
		camFovLabel.Text = "Camera FOV: " .. state.CamFOV
		applyCamFOV()
	end)
	
	camFovPlus.MouseButton1Click:Connect(function()
		state.CamFOV = math.clamp(state.CamFOV + 5, 1, 120)
		camFovLabel.Text = "Camera FOV: " .. state.CamFOV
		applyCamFOV()
	end)
	
	-- keep it forced every frame (stops games that reset FOV)
	if not connections.CamFOV then
		connections.CamFOV = RunService.RenderStepped:Connect(function()
			if Camera.FieldOfView ~= state.CamFOV then
				Camera.FieldOfView = state.CamFOV
			end
		end)
	end
	
	-- reset on character respawn if you want default back
	LocalPlayer.CharacterAdded:Connect(function()
		-- optional: uncomment if you want FOV to reset on death
		-- state.CamFOV = state.DefaultCamFOV
		-- camFovLabel.Text = "Camera FOV: " .. state.CamFOV
		-- applyCamFOV()
	end)
	
	-- ========== MOVEMENT ==========
	local speedBtn = movementPage:WaitForChild("SpeedToggle")
	local speedLabel = movementPage:WaitForChild("SpeedLabel")
	local speedMinus = movementPage:WaitForChild("SpeedMinus")
	local speedPlus = movementPage:WaitForChild("SpeedPlus")
	local flyBtn = movementPage:WaitForChild("FlyToggle")
	local noclipBtn = movementPage:WaitForChild("NoclipToggle")
	local infJumpBtn = movementPage:WaitForChild("InfJumpToggle")
	
	local function applySpeed()
		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = state.Speed and state.WalkSpeed or state.DefaultSpeed
		end
	end
	
	speedBtn.MouseButton1Click:Connect(function()
		state.Speed = not state.Speed
		setToggle(speedBtn, state.Speed)
		applySpeed()
	end)
	
	speedMinus.MouseButton1Click:Connect(function()
		state.WalkSpeed = math.max(16, state.WalkSpeed - 4)
		speedLabel.Text = "WalkSpeed: " .. state.WalkSpeed
		if state.Speed then applySpeed() end
	end)
	
	speedPlus.MouseButton1Click:Connect(function()
		state.WalkSpeed = math.min(200, state.WalkSpeed + 4)
		speedLabel.Text = "WalkSpeed: " .. state.WalkSpeed
		if state.Speed then applySpeed() end
	end)
	
	-- Fly
	local flyBV, flyBG
	flyBtn.MouseButton1Click:Connect(function()
		state.Fly = not state.Fly
		setToggle(flyBtn, state.Fly)
	
		local char = LocalPlayer.Character
		if not char then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
	
		if state.Fly then
			flyBV = Instance.new("BodyVelocity")
			flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			flyBV.Velocity = Vector3.zero
			flyBV.Parent = hrp
	
			flyBG = Instance.new("BodyGyro")
			flyBG.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
			flyBG.P = 1e4
			flyBG.Parent = hrp
	
			connections.Fly = RunService.RenderStepped:Connect(function()
				if not state.Fly or not hrp or not hrp.Parent then return end
				local camCF = Camera.CFrame
				local move = Vector3.zero
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + camCF.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - camCF.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - camCF.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + camCF.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move = move - Vector3.new(0, 1, 0) end
				flyBV.Velocity = move.Magnitude > 0 and move.Unit * 60 or Vector3.zero
				flyBG.CFrame = camCF
			end)
		else
			if connections.Fly then connections.Fly:Disconnect() end
			if flyBV then flyBV:Destroy() end
			if flyBG then flyBG:Destroy() end
			flyBV, flyBG = nil, nil
		end
	end)
	
	-- Noclip
	noclipBtn.MouseButton1Click:Connect(function()
		state.Noclip = not state.Noclip
		setToggle(noclipBtn, state.Noclip)
	
		if state.Noclip then
			connections.Noclip = RunService.Stepped:Connect(function()
				local char = LocalPlayer.Character
				if not char then return end
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end)
		else
			if connections.Noclip then connections.Noclip:Disconnect() end
			local char = LocalPlayer.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						part.CanCollide = true
					end
				end
			end
		end
	end)
	
	-- Infinite Jump
	infJumpBtn.MouseButton1Click:Connect(function()
		state.InfJump = not state.InfJump
		setToggle(infJumpBtn, state.InfJump)
	end)
	
	UserInputService.JumpRequest:Connect(function()
		if not state.InfJump then return end
		local char = LocalPlayer.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
	
	-- Re-apply speed / fly on character respawn
	LocalPlayer.CharacterAdded:Connect(function(char)
		task.wait(0.3)
		if state.Speed then applySpeed() end
		-- reset fly state on death
		if state.Fly then
			state.Fly = false
			setToggle(flyBtn, false)
			if connections.Fly then connections.Fly:Disconnect() end
		end
	end)
	
	-- Aimbot / Silent / Trigger loops (basic target selection)
	local function getClosestPlayer()
		local closest, closestDist = nil, state.AimFOV
		local mousePos = UserInputService:GetMouseLocation()
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local head = plr.Character:FindFirstChild("Head")
				if head then
					local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
					if onScreen then
						local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
						if dist < closestDist then
							closestDist = dist
							closest = plr
						end
					end
				end
			end
		end
		return closest
	end
	
	connections.Combat = RunService.RenderStepped:Connect(function()
		if not (state.Aimbot or state.SilentAim or state.Triggerbot) then return end
		local target = getClosestPlayer()
		if not target or not target.Character then return end
		local head = target.Character:FindFirstChild("Head")
		if not head then return end
	
		if state.Aimbot then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
		end
	
		-- Silent aim and triggerbot are stubs ready for game-specific remote hooks
		-- You can extend them by finding the game's fire remote / mouse event
	end)
	
	
	
	print("[HRNR Cheat GUI] Loaded. Insert to toggle menu.")
	
end
coroutine.wrap(SNKHFD_fake_script)()
