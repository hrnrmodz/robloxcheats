-- Scripts:

local function XCYJW_fake_script() -- HRNR_MODZ.MainController 
	local script = Instance.new('LocalScript', HRNR_MODZ)

	
	-- HRNR_MODZ v5.0 full static pages
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local Lighting = game:GetService("Lighting")
	local LocalPlayer = Players.LocalPlayer
	local Camera = workspace.CurrentCamera
	
	local gui = script.Parent
	local main = gui:WaitForChild("MainFrame")
	local content = main:WaitForChild("Content")
	local tabBar = main:WaitForChild("TabBar")
	local closeBtn = main:WaitForChild("TitleBar"):WaitForChild("CloseBtn")
	
	local pages = {
		Combat = content:WaitForChild("CombatPage"),
		Visuals = content:WaitForChild("VisualsPage"),
		Move = content:WaitForChild("MovePage"),
		Player = content:WaitForChild("PlayerPage"),
		World = content:WaitForChild("WorldPage"),
		Settings = content:WaitForChild("SettingsPage"),
		Games = content:FindFirstChild("GamesPage"),
	}
	local tabBtns = {
		Combat = tabBar:WaitForChild("CombatTab"),
		Visuals = tabBar:WaitForChild("VisualsTab"),
		Move = tabBar:WaitForChild("MoveTab"),
		Player = tabBar:WaitForChild("PlayerTab"),
		World = tabBar:WaitForChild("WorldTab"),
		Settings = tabBar:WaitForChild("SettingsTab"),
	}
	
	local S = {
		Aimbot=false, SilentAim=false, Triggerbot=false, SmoothAim=false, FOVCircle=false, AimFOV=80,
		ESP=false, BoxESP=false, NameESP=false, Tracers=false, Chams=false,
		HealthESP=false, DistanceESP=false, Crosshair=false,
		Speed=false, Fly=false, Noclip=false, InfJump=false, Bhop=false,
		ClickTP=false, Orbit=false, Float=false,
		GodMode=false, InfHealth=false, ForceField=false, AntiAFK=false,
		Spinbot=false, Invisible=false, NoFall=false,
		Fullbright=false, NoFog=false, Xray=false, Zoom=false, Gravity=false,
		WalkSpeed=50, FlySpeed=70, CamFOV=70,
	}
	local cons, drawings = {}, {}
	
	local function setBtn(btn, on)
		local base = btn.Name:gsub("Toggle","")
		if on then
			btn.Text = base .. "  ·  ON"
			btn.BackgroundColor3 = Color3.fromRGB(28,90,60)
		else
			btn.Text = base .. "  ·  OFF"
			btn.BackgroundColor3 = Color3.fromRGB(26,26,36)
		end
	end
	
	local function switch(name)
		for n, p in pairs(pages) do p.Visible = (n == name) end
		for n, b in pairs(tabBtns) do
			if n == name then
				b.BackgroundColor3 = Color3.fromRGB(30,36,56)
				b.TextColor3 = Color3.fromRGB(230,235,255)
			else
				b.BackgroundColor3 = Color3.fromRGB(18,18,26)
				b.TextColor3 = Color3.fromRGB(140,140,165)
			end
		end
	end
	
	for name, btn in pairs(tabBtns) do
		btn.MouseButton1Click:Connect(function() switch(name) end)
	end
	switch("Combat")
	
	closeBtn.MouseButton1Click:Connect(function() main.Visible = false end)
	
	-- Minimize
	local minimized = false
	local fullSize = main.Size
	local minBtn = Instance.new("TextButton")
	minBtn.Name = "MinBtn"
	minBtn.Size = UDim2.new(0, 24, 0, 24)
	minBtn.Position = UDim2.new(1, -58, 0, 4)
	minBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
	minBtn.BorderSizePixel = 0
	minBtn.Text = "—"
	minBtn.TextColor3 = Color3.new(1,1,1)
	minBtn.TextSize = 14
	minBtn.Parent = main.TitleBar
	local mc = Instance.new("UICorner")
	mc.CornerRadius = UDim.new(0,4)
	mc.Parent = minBtn
	minBtn.MouseButton1Click:Connect(function()
		minimized = not minimized
		if minimized then
			content.Visible = false
			tabBar.Visible = false
			main.Size = UDim2.new(0, fullSize.X.Offset, 0, 34)
			minBtn.Text = "+"
		else
			content.Visible = true
			tabBar.Visible = true
			main.Size = fullSize
			minBtn.Text = "—"
		end
	end)
	
	UserInputService.InputBegan:Connect(function(i, g)
		if g then return end
		if i.KeyCode == Enum.KeyCode.Insert then main.Visible = not main.Visible end
	end)
	
	-- drag
	local dragging, dragStart, startPos
	main.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging=true; dragStart=i.Position; startPos=main.Position
		end
	end)
	main.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging=false end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
			local d = i.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
		end
	end)
	
	local function wire(page, btnName, key, extra)
		local btn = page:FindFirstChild(btnName)
		if not btn then return end
		btn.MouseButton1Click:Connect(function()
			S[key] = not S[key]
			setBtn(btn, S[key])
			if extra then extra(S[key]) end
		end)
	end
	
	-- Combat
	wire(pages.Combat, "AimbotToggle", "Aimbot")
	wire(pages.Combat, "SilentAimToggle", "SilentAim")
	wire(pages.Combat, "TriggerbotToggle", "Triggerbot")
	wire(pages.Combat, "SmoothAimToggle", "SmoothAim")
	wire(pages.Combat, "FOVCircleToggle", "FOVCircle")
	
	-- Visuals
	local function refreshESP()
		for _, d in pairs(drawings) do pcall(function() d:Destroy() end) end
		drawings = {}
		if not (S.ESP or S.BoxESP or S.NameESP or S.Chams or S.Tracers or S.HealthESP or S.DistanceESP) then return end
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character then
				local char = plr.Character
				local head = char:FindFirstChild("Head")
				local hum = char:FindFirstChildOfClass("Humanoid")
				local hrp = char:FindFirstChild("HumanoidRootPart")
				if S.BoxESP or S.Chams or S.ESP then
					local hl = Instance.new("Highlight")
					hl.Adornee = char
					hl.FillColor = Color3.fromRGB(70,150,255)
					hl.OutlineColor = Color3.new(1,1,1)
					hl.FillTransparency = S.Chams and 0.4 or 0.7
					hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
					hl.Parent = char
					table.insert(drawings, hl)
				end
				if (S.NameESP or S.HealthESP or S.DistanceESP) and head then
					local bill = Instance.new("BillboardGui")
					bill.Adornee = head
					bill.Size = UDim2.new(0, 160, 0, 40)
					bill.StudsOffset = Vector3.new(0, 2.5, 0)
					bill.AlwaysOnTop = true
					bill.Parent = head
					local txt = Instance.new("TextLabel")
					txt.Size = UDim2.new(1,0,1,0)
					txt.BackgroundTransparency = 1
					txt.TextColor3 = Color3.fromRGB(90,170,255)
					txt.TextStrokeTransparency = 0.4
					txt.TextSize = 12
					txt.Font = Enum.Font.GothamMedium
					txt.Parent = bill
					local parts = {}
					if S.NameESP then table.insert(parts, plr.Name) end
					if S.HealthESP and hum then table.insert(parts, math.floor(hum.Health).." HP") end
					if S.DistanceESP and hrp and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
						table.insert(parts, math.floor((hrp.Position-LocalPlayer.Character.HumanoidRootPart.Position).Magnitude).."m")
					end
					txt.Text = table.concat(parts, " | ")
					table.insert(drawings, bill)
				end
				if S.Tracers and hrp then
					local my = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if my then
						local a0 = Instance.new("Attachment"); a0.Parent = my
						local a1 = Instance.new("Attachment"); a1.Parent = hrp
						local beam = Instance.new("Beam")
						beam.Attachment0 = a0; beam.Attachment1 = a1
						beam.Color = ColorSequence.new(Color3.fromRGB(80,160,255))
						beam.Width0 = 0.08; beam.Width1 = 0.08
						beam.FaceCamera = true
						beam.Transparency = NumberSequence.new(0.3)
						beam.Parent = my
						table.insert(drawings, beam)
						table.insert(drawings, a0)
						table.insert(drawings, a1)
					end
				end
			end
		end
	end
	wire(pages.Visuals, "ESPToggle", "ESP", function(v) if v then S.BoxESP=true; S.NameESP=true else S.BoxESP=false; S.NameESP=false; S.Tracers=false; S.Chams=false; S.HealthESP=false; S.DistanceESP=false end refreshESP() end)
	wire(pages.Visuals, "BoxESPToggle", "BoxESP", refreshESP)
	wire(pages.Visuals, "NameESPToggle", "NameESP", refreshESP)
	wire(pages.Visuals, "TracersToggle", "Tracers", refreshESP)
	wire(pages.Visuals, "ChamsToggle", "Chams", refreshESP)
	wire(pages.Visuals, "HealthESPToggle", "HealthESP")
	wire(pages.Visuals, "DistanceESPToggle", "DistanceESP")
	wire(pages.Visuals, "CrosshairToggle", "Crosshair")
	
	-- Move
	wire(pages.Move, "SpeedToggle", "Speed", function(v)
		local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
		if h then h.WalkSpeed = v and S.WalkSpeed or 16 end
	end)
	wire(pages.Move, "FlyToggle", "Fly", function(v)
		local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		if v then
			local bv = Instance.new("BodyVelocity"); bv.MaxForce=Vector3.new(1e5,1e5,1e5); bv.Parent=hrp
			local bg = Instance.new("BodyGyro"); bg.MaxTorque=Vector3.new(1e5,1e5,1e5); bg.P=1e4; bg.Parent=hrp
			cons.Fly = RunService.RenderStepped:Connect(function()
				if not S.Fly or not hrp.Parent then return end
				local cf = Camera.CFrame
				local m = Vector3.zero
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then m=m+cf.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then m=m-cf.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then m=m-cf.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then m=m+cf.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then m=m+Vector3.yAxis end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then m=m-Vector3.yAxis end
				bv.Velocity = m.Magnitude>0 and m.Unit*S.FlySpeed or Vector3.zero
				bg.CFrame = cf
			end)
			cons.FlyBV=bv; cons.FlyBG=bg
		else
			if cons.Fly then cons.Fly:Disconnect() end
			if cons.FlyBV then cons.FlyBV:Destroy() end
			if cons.FlyBG then cons.FlyBG:Destroy() end
		end
	end)
	wire(pages.Move, "NoclipToggle", "Noclip", function(v)
		if v then
			cons.Noclip = RunService.Stepped:Connect(function()
				local c = LocalPlayer.Character
				if c then for _,p in ipairs(c:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end end
			end)
		else
			if cons.Noclip then cons.Noclip:Disconnect() end
		end
	end)
	wire(pages.Move, "InfJumpToggle", "InfJump")
	wire(pages.Move, "BhopToggle", "Bhop")
	wire(pages.Move, "ClickTPToggle", "ClickTP")
	wire(pages.Move, "OrbitToggle", "Orbit")
	wire(pages.Move, "FloatToggle", "Float")
	
	-- Player
	wire(pages.Player, "GodModeToggle", "GodMode")
	wire(pages.Player, "InfHealthToggle", "InfHealth")
	wire(pages.Player, "ForceFieldToggle", "ForceField", function(v)
		local c = LocalPlayer.Character
		if v and c then
			local ff=Instance.new("ForceField"); ff.Parent=c; cons.FF=ff
		elseif cons.FF then cons.FF:Destroy() end
	end)
	wire(pages.Player, "AntiAFKToggle", "AntiAFK", function(v)
		if v then
			cons.AntiAFK = RunService.Heartbeat:Connect(function()
				local vu=game:GetService("VirtualUser"); vu:CaptureController(); vu:ClickButton2(Vector2.new())
			end)
		else
			if cons.AntiAFK then cons.AntiAFK:Disconnect() end
		end
	end)
	wire(pages.Player, "SpinbotToggle", "Spinbot", function(v)
		if v then
			cons.Spin = RunService.RenderStepped:Connect(function()
				local hrp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if hrp then hrp.CFrame=hrp.CFrame*CFrame.Angles(0,math.rad(12),0) end
			end)
		else
			if cons.Spin then cons.Spin:Disconnect() end
		end
	end)
	wire(pages.Player, "InvisibleToggle", "Invisible", function(v)
		local c=LocalPlayer.Character
		if c then for _,p in ipairs(c:GetDescendants()) do
			if p:IsA("BasePart") then p.Transparency=v and 1 or 0 end
			if p:IsA("Decal") then p.Transparency=v and 1 or 0 end
		end end
	end)
	wire(pages.Player, "NoFallToggle", "NoFall")
	
	-- World
	wire(pages.World, "FullbrightToggle", "Fullbright", function(v)
		if v then
			Lighting.Brightness=2; Lighting.ClockTime=14; Lighting.FogEnd=1e5
			Lighting.GlobalShadows=false; Lighting.OutdoorAmbient=Color3.fromRGB(180,180,180)
		else
			Lighting.Brightness=1; Lighting.GlobalShadows=true
			Lighting.OutdoorAmbient=Color3.fromRGB(70,70,70)
		end
	end)
	wire(pages.World, "NoFogToggle", "NoFog", function(v) Lighting.FogEnd=v and 1e5 or 1000 end)
	wire(pages.World, "XrayToggle", "Xray", function(v)
		for _,p in ipairs(workspace:GetDescendants()) do
			if p:IsA("BasePart") and p.Transparency<1 then p.LocalTransparencyModifier=v and 0.7 or 0 end
		end
	end)
	wire(pages.World, "ZoomToggle", "Zoom", function(v) LocalPlayer.CameraMaxZoomDistance=v and 1000 or 128 end)
	wire(pages.World, "GravityToggle", "Gravity", function(v) workspace.Gravity=v and 50 or 196.2 end)
	
	-- loops
	UserInputService.JumpRequest:Connect(function()
		if S.InfJump then
			local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
	end)
	RunService.Heartbeat:Connect(function()
		if S.Bhop then
			local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h and h.FloorMaterial~=Enum.Material.Air then h.Jump=true end
		end
		if S.GodMode or S.InfHealth then
			local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then h.Health=h.MaxHealth end
		end
		if S.NoFall then
			local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then
				h:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
				h:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
			end
		end
	end)
	UserInputService.InputBegan:Connect(function(i,g)
		if g then return end
		if S.ClickTP and i.UserInputType==Enum.UserInputType.MouseButton1 then
			local m=LocalPlayer:GetMouse()
			local hrp=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if hrp and m.Hit then hrp.CFrame=CFrame.new(m.Hit.Position+Vector3.new(0,3,0)) end
		end
	end)
	RunService.RenderStepped:Connect(function()
		if Camera.FieldOfView ~= S.CamFOV then Camera.FieldOfView=S.CamFOV end
		if not S.Aimbot then return end
		local closest,dist=nil,100
		local mouse=UserInputService:GetMouseLocation()
		for _,p in ipairs(Players:GetPlayers()) do
			if p~=LocalPlayer and p.Character then
				local head=p.Character:FindFirstChild("Head")
				if head then
					local sp,on=Camera:WorldToViewportPoint(head.Position)
					if on then
						local d=(Vector2.new(sp.X,sp.Y)-mouse).Magnitude
						if d<dist then dist=d; closest=head end
					end
				end
			end
		end
		if closest then
			if S.SmoothAim then
				Camera.CFrame=Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,closest.Position),0.15)
			else
				Camera.CFrame=CFrame.new(Camera.CFrame.Position,closest.Position)
			end
		end
	end)
	
	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.4)
		if S.Speed then
			local h=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then h.WalkSpeed=S.WalkSpeed end
		end
		if S.Fly then S.Fly=false; if cons.Fly then cons.Fly:Disconnect() end end
	end)
	
	
	-- Dynamic Games tab button
	-- Resize existing tabs tighter so Games fits
	local tabOrder = {"Combat","Visuals","Move","Player","World","Settings"}
	local tw = 52
	for i, name in ipairs(tabOrder) do
		local b = tabBtns[name]
		if b then
			b.Size = UDim2.new(0, tw, 0, 26)
			b.Position = UDim2.new(0, 4 + (i-1)*(tw+2), 0, 3)
			b.TextSize = 10
		end
	end
	local gamesTab = Instance.new("TextButton")
	gamesTab.Name = "GamesTab"
	gamesTab.Size = UDim2.new(0, 52, 0, 26)
	gamesTab.Position = UDim2.new(0, 4 + 6*(tw+2), 0, 3)
	gamesTab.BackgroundColor3 = Color3.fromRGB(18,18,26)
	gamesTab.BorderSizePixel = 0
	gamesTab.Text = "Games"
	gamesTab.TextColor3 = Color3.fromRGB(140,140,165)
	gamesTab.TextSize = 10
	gamesTab.Font = Enum.Font.GothamMedium
	gamesTab.Parent = tabBar
	local gc = Instance.new("UICorner")
	gc.CornerRadius = UDim.new(0,4)
	gc.Parent = gamesTab
	tabBtns.Games = gamesTab
	local gp = content:FindFirstChild("GamesPage")
	if not gp then
		gp = Instance.new("Frame")
		gp.Name = "GamesPage"
		gp.Size = UDim2.new(1,0,0,550)
		gp.BackgroundTransparency = 1
		gp.Visible = false
		gp.Parent = content
		local function gl(text, y)
			local l = Instance.new("TextLabel")
			l.Size = UDim2.new(1,-28,0,18)
			l.Position = UDim2.new(0,14,0,y)
			l.BackgroundTransparency = 1
			l.Text = text
			l.TextColor3 = Color3.fromRGB(130,130,150)
			l.TextSize = 12
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.Parent = gp
		end
		local function gt(name, label, y)
			local b = Instance.new("TextButton")
			b.Name = name
			b.Size = UDim2.new(1,-24,0,30)
			b.Position = UDim2.new(0,12,0,y)
			b.BackgroundColor3 = Color3.fromRGB(26,26,36)
			b.BorderSizePixel = 0
			b.Text = label .. "  ·  OFF"
			b.TextColor3 = Color3.fromRGB(230,230,245)
			b.TextSize = 13
			b.Parent = gp
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0,5)
			c.Parent = b
			return b
		end
		gl("── Steal An Egg ──", 8)
		gt("SAE_AutoSteal", "Auto Steal", 32)
		gt("SAE_AutoHatch", "Auto Hatch", 68)
		gt("SAE_AutoSell", "Auto Sell", 104)
		gl("── Murder Mystery 2 ──", 148)
		gt("MM2_ESP", "Role ESP", 172)
		gt("MM2_Farm", "Coin Farm", 208)
		gl("── Blox Fruits ──", 252)
		gt("BF_AutoFarm", "Auto Farm", 276)
		gt("BF_ESP", "Player ESP", 312)
		gl("Stubs — wire remotes with a spy", 360)
	end
	pages.Games = gp
	gamesTab.MouseButton1Click:Connect(function() switch("Games") end)
	
	-- Theme + settings wiring
	local settingsPage = pages.Settings
	local themes = {
		Blue = Color3.fromRGB(56,130,255),
		Purple = Color3.fromRGB(140,80,230),
		Green = Color3.fromRGB(50,180,100),
		Red = Color3.fromRGB(220,60,60),
	}
	local function applyTheme(name)
		local c = themes[name] or themes.Blue
		local title = main.TitleBar:FindFirstChild("Title")
		if title then title.TextColor3 = c end
		main.BackgroundColor3 = Color3.fromRGB(math.floor(c.R*20), math.floor(c.G*20), math.floor(c.B*25))
		content.BackgroundColor3 = Color3.fromRGB(math.floor(c.R*15), math.floor(c.G*15), math.floor(c.B*18))
		tabBar.BackgroundColor3 = Color3.fromRGB(math.floor(c.R*12), math.floor(c.G*12), math.floor(c.B*15))
		main.TitleBar.BackgroundColor3 = Color3.fromRGB(math.floor(c.R*10), math.floor(c.G*10), math.floor(c.B*12))
		content.ScrollBarImageColor3 = c
		for _, b in pairs(tabBtns) do
			if b.TextColor3.R > 0.8 then
				b.BackgroundColor3 = Color3.fromRGB(math.floor(c.R*40), math.floor(c.G*40), math.floor(c.B*50))
			end
		end
	end
	for _, name in ipairs({"Blue","Purple","Green","Red"}) do
		local b = settingsPage:FindFirstChild("Theme"..name)
		if b then
			b.MouseButton1Click:Connect(function() applyTheme(name) end)
		end
	end
	
	local flyLbl = settingsPage:FindFirstChild("FlySpeedLabel")
	local walkLbl = settingsPage:FindFirstChild("WalkSpeedLabel")
	local fovLbl = settingsPage:FindFirstChild("CamFOVLabel")
	local function updLabels()
		if flyLbl then flyLbl.Text = "Fly Speed  ·  " .. S.FlySpeed end
		if walkLbl then walkLbl.Text = "WalkSpeed  ·  " .. S.WalkSpeed end
		if fovLbl then fovLbl.Text = "Camera FOV  ·  " .. S.CamFOV end
	end
	local fsMinus = settingsPage:FindFirstChild("FlySpeedMinus")
	local fsPlus = settingsPage:FindFirstChild("FlySpeedPlus")
	if fsMinus then fsMinus.MouseButton1Click:Connect(function() S.FlySpeed = math.clamp(S.FlySpeed-10,20,300); updLabels() end) end
	if fsPlus then fsPlus.MouseButton1Click:Connect(function() S.FlySpeed = math.clamp(S.FlySpeed+10,20,300); updLabels() end) end
	local wsMinus = settingsPage:FindFirstChild("WalkSpeedMinus")
	local wsPlus = settingsPage:FindFirstChild("WalkSpeedPlus")
	if wsMinus then wsMinus.MouseButton1Click:Connect(function()
		S.WalkSpeed = math.clamp(S.WalkSpeed-5,16,250); updLabels()
		if S.Speed then
			local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then h.WalkSpeed = S.WalkSpeed end
		end
	end) end
	if wsPlus then wsPlus.MouseButton1Click:Connect(function()
		S.WalkSpeed = math.clamp(S.WalkSpeed+5,16,250); updLabels()
		if S.Speed then
			local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if h then h.WalkSpeed = S.WalkSpeed end
		end
	end) end
	local fovMinus = settingsPage:FindFirstChild("CamFOVMinus")
	local fovPlus = settingsPage:FindFirstChild("CamFOVPlus")
	if fovMinus then fovMinus.MouseButton1Click:Connect(function() S.CamFOV = math.clamp(S.CamFOV-5,1,120); updLabels() end) end
	if fovPlus then fovPlus.MouseButton1Click:Connect(function() S.CamFOV = math.clamp(S.CamFOV+5,1,120); updLabels() end) end
	
	-- Games stubs
	local function wireGame(btnName, key)
		local b = pages.Games:FindFirstChild(btnName)
		if not b then return end
		b.MouseButton1Click:Connect(function()
			S[key] = not (S[key] or false)
			S[key] = S[key]
			local on = S[key]
			b.Text = btnName:gsub("_"," ") .. (on and "  ·  ON" or "  ·  OFF")
			b.BackgroundColor3 = on and Color3.fromRGB(28,90,60) or Color3.fromRGB(26,26,36)
			print("[HRNR] Games", key, "=", on)
		end)
	end
	wireGame("SAE_AutoSteal", "SAE_AutoSteal")
	wireGame("SAE_AutoHatch", "SAE_AutoHatch")
	wireGame("SAE_AutoSell", "SAE_AutoSell")
	wireGame("MM2_ESP", "MM2_ESP")
	wireGame("MM2_Farm", "MM2_Farm")
	wireGame("BF_AutoFarm", "BF_AutoFarm")
	wireGame("BF_ESP", "BF_ESP")
	
	
	-- Build Settings UI if static theme buttons missing
	do
		local sp = pages.Settings
		if sp then
			for _,c in ipairs(sp:GetChildren()) do c:Destroy() end
			local function lbl(text, y)
				local l = Instance.new("TextLabel")
				l.Size = UDim2.new(1,-28,0,18)
				l.Position = UDim2.new(0,14,0,y)
				l.BackgroundTransparency = 1
				l.Text = text
				l.TextColor3 = Color3.fromRGB(130,130,150)
				l.TextSize = 12
				l.TextXAlignment = Enum.TextXAlignment.Left
				l.Parent = sp
				return l
			end
			local function btn(name, text, x, y, color)
				local b = Instance.new("TextButton")
				b.Name = name
				b.Size = UDim2.new(0,60,0,28)
				b.Position = UDim2.new(0,x,0,y)
				b.BackgroundColor3 = color
				b.BorderSizePixel = 0
				b.Text = text
				b.TextColor3 = Color3.new(1,1,1)
				b.TextSize = 12
				b.Parent = sp
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(0,5)
				c.Parent = b
				return b
			end
			-- clear old labels
			for _,c in ipairs(sp:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
			lbl("── Theme ──", 8)
			local themes = {
				{"ThemeBlue","Blue",12,Color3.fromRGB(56,130,255)},
				{"ThemePurple","Purple",80,Color3.fromRGB(140,80,230)},
				{"ThemeGreen","Green",148,Color3.fromRGB(50,180,100)},
				{"ThemeRed","Red",216,Color3.fromRGB(220,60,60)},
			}
			for _,t in ipairs(themes) do
				local b = btn(t[1], t[2], t[3], 32, t[4])
				b.MouseButton1Click:Connect(function()
					local title = main.TitleBar:FindFirstChild("Title")
					if title then title.TextColor3 = t[4] end
				end)
			end
			lbl("── Mod Settings ──", 72)
			local flyLbl = lbl("Fly Speed  ·  "..S.FlySpeed, 98)
			flyLbl.Name = "FlySpeedLabel"
			local function adj(name, x, y, delta, key, minv, maxv, steplbl)
				local b = Instance.new("TextButton")
				b.Name = name
				b.Size = UDim2.new(0,36,0,28)
				b.Position = UDim2.new(0,x,0,y)
				b.BackgroundColor3 = Color3.fromRGB(30,30,42)
				b.BorderSizePixel = 0
				b.Text = delta > 0 and "+" or "-"
				b.TextColor3 = Color3.new(1,1,1)
				b.TextSize = 14
				b.Parent = sp
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(0,4)
				c.Parent = b
				b.MouseButton1Click:Connect(function()
					S[key] = math.clamp(S[key] + delta, minv, maxv)
					if steplbl then
						local names = {FlySpeed="Fly Speed", WalkSpeed="WalkSpeed", CamFOV="Camera FOV"}
						steplbl.Text = (names[key] or key) .. "  ·  " .. S[key]
					end
					if key == "WalkSpeed" and S.Speed then
						local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
						if h then h.WalkSpeed = S.WalkSpeed end
					end
				end)
			end
			adj("FlySpeedMinus", 12, 120, -10, "FlySpeed", 20, 300, flyLbl)
			adj("FlySpeedPlus", 54, 120, 10, "FlySpeed", 20, 300, flyLbl)
			local walkLbl = lbl("WalkSpeed  ·  "..S.WalkSpeed, 160)
			walkLbl.Name = "WalkSpeedLabel"
			adj("WalkSpeedMinus", 12, 182, -5, "WalkSpeed", 16, 250, walkLbl)
			adj("WalkSpeedPlus", 54, 182, 5, "WalkSpeed", 16, 250, walkLbl)
			local fovLbl = lbl("Camera FOV  ·  "..S.CamFOV, 222)
			fovLbl.Name = "CamFOVLabel"
			adj("CamFOVMinus", 12, 244, -5, "CamFOV", 1, 120, fovLbl)
			adj("CamFOVPlus", 54, 244, 5, "CamFOV", 1, 120, fovLbl)
			lbl("hrnr + Grok  ·  v5.1", 290)
		end
	end
	
	
	-- FOV Circle + Crosshair
	local fovFrame, crossFrame
	local function updateFOVCircle()
		if S.FOVCircle then
			if not fovFrame then
				fovFrame = Instance.new("Frame")
				fovFrame.Name = "FOVCircle"
				fovFrame.AnchorPoint = Vector2.new(0.5, 0.5)
				fovFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
				fovFrame.BackgroundTransparency = 1
				fovFrame.Parent = gui
				local s = Instance.new("UIStroke")
				s.Name = "Stroke"
				s.Color = Color3.fromRGB(80, 160, 255)
				s.Thickness = 1.5
				s.Parent = fovFrame
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(1, 0)
				c.Parent = fovFrame
			end
			local px = (S.AimFOV or 80) * 2
			fovFrame.Size = UDim2.new(0, px, 0, px)
			fovFrame.Visible = true
		elseif fovFrame then
			fovFrame.Visible = false
		end
	end
	local function updateCrosshair()
		if S.Crosshair then
			if not crossFrame then
				crossFrame = Instance.new("Frame")
				crossFrame.Name = "Crosshair"
				crossFrame.Size = UDim2.new(0, 8, 0, 8)
				crossFrame.AnchorPoint = Vector2.new(0.5, 0.5)
				crossFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
				crossFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
				crossFrame.BorderSizePixel = 0
				crossFrame.Parent = gui
				local c = Instance.new("UICorner")
				c.CornerRadius = UDim.new(1, 0)
				c.Parent = crossFrame
			end
			crossFrame.Visible = true
		elseif crossFrame then
			crossFrame.Visible = false
		end
	end
	
	
	-- Hook FOVCircle / Crosshair toggles via polling (state already set by wire)
	RunService.RenderStepped:Connect(function()
		updateFOVCircle()
		updateCrosshair()
	end)
	
	print("[HRNR_MODZ] v5.1 loaded — Settings + Games — Insert")
	
end
coroutine.wrap(XCYJW_fake_script)()
